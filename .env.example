# =========================================================================
# SIGA IPT - Environment Configuration Template
# =========================================================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# Keycloak Administrator Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password

# Keycloak Service Account Secret (for Backend Admin Operations)
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# Default Temporary Password for Provisioned Users (Teachers & Students)
KEYCLOAK_DEFAULT_PASSWORD=your_temporary_default_password

# Public Keycloak URL accessed by user browser (e.g. http://<EC2-IP>:8080 or http://localhost:8080)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/siga-ipt-realm
FRONTEND_KEYCLOAK_URL=http://localhost:8080

# Docker Hub Image Repository Tags (Production Cloud Deployment)
DOCKER_HUB_BACKEND_IMAGE=rgonzalez23/siga-backend:latest
DOCKER_HUB_FRONTEND_IMAGE=rgonzalez23/siga-frontend:latest
